{
  "name": "@markschema/mdshape",
  "version": "0.1.0",
  "type": "module",
  "description": "Type-safe Markdown validation with a schema-first API.",
  "author": "Daniel Marques Refiski <daniel@refiski.com>",
  "license": "MIT",
  "homepage": "https://docs.markschema.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markschema/markschema.git",
    "directory": "packages/mdshape"
  },
  "bugs": {
    "url": "https://github.com/markschema/markschema/issues"
  },
  "keywords": [
    "markdown",
    "schema",
    "validation",
    "type-safe",
    "remark",
    "frontmatter",
    "mdshape",
    "markschema"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@markschema/typescript-config": "*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
