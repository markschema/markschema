{
  "name": "@markschema/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:monaco-types": "node ./scripts/generate-monaco-mdshape-dts.mjs",
    "predev": "npm run --workspace @markschema/mdshape build && npm run generate:monaco-types",
    "dev": "next dev --turbopack --port 3001",
    "prebuild": "npm run --workspace @markschema/mdshape build && npm run generate:monaco-types",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint --max-warnings 0",
    "precheck-types": "npm run --workspace @markschema/mdshape build && npm run generate:monaco-types",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@markschema/mdshape": "*",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.38",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@markschema/eslint-config": "*",
    "@markschema/tailwind-config": "*",
    "@markschema/typescript-config": "*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "monaco-editor": "^0.54.0",
    "typescript": "5.9.2"
  }
}
