# PostHog — analytics dos docs (apps/docs)
#
# A project API key é PÚBLICA por design (vai no bundle do cliente).
# Pegue em: PostHog → Settings → Project → "Project API Key" (phc_...).
#
# Sem VITE_POSTHOG_KEY definida, o tracking não inicializa — ideal pra dev local.
#
# Produção (Cloudflare Pages): defina como variáveis de ambiente do build.
# Dev local: rode com a env inline (método à prova de path):
#   VITE_POSTHOG_KEY=phc_xxx npm run dev --workspace @markschema/docs

VITE_POSTHOG_KEY=

# Host da instância PostHog. Padrão: US.
#   US: https://us.i.posthog.com
#   EU: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
